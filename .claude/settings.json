{
  "permissions": {
    "allow": [
      "Bash(git tag*)"
    ],
    "ask": [
      "Bash(git add*)",
      "Bash(git rm*)",
      "Bash(git mv*)",
      "Bash(git restore*)"
    ],
    "deny": [
      "Bash(git commit*)",
      "Bash(git reset*)",
      "Bash(git push*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git stash*)",
      "Bash(git cherry-pick*)",
      "Bash(git revert*)",
      "Bash(git clean*)",
      "Bash(git add -A*)",
      "Bash(git add .*)",
      "Bash(git add -f*)",
      "Bash(git add --force*)"
    ]
  }
}
