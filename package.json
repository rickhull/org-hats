{
  "name": "org-hats",
  "version": "2.1.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "description": "A portable organizational authority subsystem — use-case authority runtime, signed access envelopes, and a verification-only access module. v2 line; the v0.4 organization model lives at its tags.",
  "license": "MIT",
  "author": "Rick <rick@thinkpad>",
  "repository": { "type": "git", "url": "git+https://codeberg.org/rickhull/org-hats.git" },
  "homepage": "https://codeberg.org/rickhull/org-hats",
  "bugs": { "url": "https://codeberg.org/rickhull/org-hats/issues" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./authority": {
      "types": "./dist/authority/index.d.ts",
      "default": "./dist/authority/index.js"
    },
    "./access": {
      "types": "./dist/access/index.d.ts",
      "default": "./dist/access/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "default": "./dist/conformance.js"
    }
  },
  "files": ["dist", "SECURITY.md"],
  "scripts": {
    "check": "bin/check",
    "check:dist": "bin/check-dist",
    "check:deploy": "bin/check-deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json && tsc -p tsconfig.consumer.json",
    "test": "node --test tests/*.test.ts",
    "test:tools": "node --test tests/release-tools.test.ts tests/gate-cache.test.ts tests/deploy-check.test.ts",
    "build": "rm -rf dist && tsc -p tsconfig.json && node bin/fix-dts.mjs",
    "check:cloudflare": "pnpm --filter org-hats-cloudflare typecheck && pnpm --filter org-hats-cloudflare test",
    "verify": "bin/verify"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
