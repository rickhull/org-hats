{
  "name": "org-hats",
  "version": "0.4.0",
  "type": "module",
  "description": "A small, reusable organization model — types, predicates, an async persistence port, and a request spine that composes them in the model's order. SQLite reference adapter at org-hats/node.",
  "license": "MIT",
  "author": "Rick <rick@thinkpad>",
  "repository": { "type": "git", "url": "git+https://codeberg.org/rickhull/org-hats.git" },
  "homepage": "https://codeberg.org/rickhull/org-hats",
  "bugs": { "url": "https://codeberg.org/rickhull/org-hats/issues" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "check": "bin/check",
    "examples": "node examples/check.ts",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
