{
  "name": "org-hats",
  "version": "1.1.0",
  "type": "module",
  "description": "A portable organizational authority subsystem — use-case authority runtime, signed access envelopes, and a verification-only access module. v1 in development on the v1 branch; the v0.4 organization model lives on main at its tags.",
  "license": "MIT",
  "author": "Rick <rick@thinkpad>",
  "repository": { "type": "git", "url": "git+https://codeberg.org/rickhull/org-hats.git" },
  "homepage": "https://codeberg.org/rickhull/org-hats",
  "bugs": { "url": "https://codeberg.org/rickhull/org-hats/issues" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./authority": {
      "types": "./dist/authority/index.d.ts",
      "default": "./dist/authority/index.js"
    },
    "./access": {
      "types": "./dist/access/index.d.ts",
      "default": "./dist/access/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance.d.ts",
      "default": "./dist/conformance.js"
    }
  },
  "files": ["dist", "SECURITY.md"],
  "scripts": {
    "check": "bin/check",
    "typecheck": "tsc -p tsconfig.authority.json && tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json && node bin/fix-dts.mjs",
    "check:cloudflare": "pnpm --filter org-hats-cloudflare typecheck && pnpm --filter org-hats-cloudflare test"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
