# Direct access to workspace binaries: `vitest`, `wrangler`, `tsc` instead
# of `pnpm --filter org-hats-cloudflare exec ...`.  Requires the direnv hook
# (programs.direnv.enable) and a one-time `direnv allow` in this directory.
# No secrets here: wrangler dev reads .dev.vars; deploys read account
# secrets.  Nothing else belongs in this file.

# The project flake provides Node, pnpm, and fj; the parent envrc is optional.
source_env_if_exists ../.envrc
use flake
PATH_add bin
PATH_add node_modules/.bin
PATH_add packages/cloudflare/node_modules/.bin

# Link this repository's skill packs from the shared agent-skills library.
# The links are machine-local and gitignored because a symlink cannot hold
# `~`; the generator is the tracked part.  A missing library is reported and
# never fatal to the shell: entering a clone without it should still work.
if [[ -x bin/wire-skills ]]; then
  bin/wire-skills || log_status "skill packs are not linked; see bin/wire-skills"
fi
