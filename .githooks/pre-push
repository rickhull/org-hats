#!/usr/bin/env sh
# Pre-push gate: validate every release tag being pushed, build dist/ and
# refuse a stale one, then run bin/check.
#
# Install once per clone:
#   git config core.hooksPath .githooks
#
# git passes one line per ref on stdin:
#   <local ref> <local sha> <remote ref> <remote sha>
set -eu
cd "$(dirname "$0")/.." || exit 1

fail=0

# 1. Every release tag being pushed must match the manifest in its own commit.
#    Both tag families are checked; the script infers the manifest.
while read -r local_ref local_sha remote_ref remote_sha; do
	case $local_sha in
		*[!0]*) ;;
		*) continue ;; # a deletion has an all-zero local sha
	esac
	case $remote_ref in
		# v0.4.3 tags a commit whose package.json is still 0.4.2. It
		# predates the guard, is immutable, and is already published on
		# the canonical host; skipping it here keeps the guard meaningful
		# for every other tag. docs/publishing.md records the anomaly.
		refs/tags/v0.4.3) continue ;;
		refs/tags/v[0-9]*|refs/tags/cloudflare-v[0-9]*)
			bin/check-version "${remote_ref#refs/tags/}" || fail=1
			;;
	esac
done

# 2. The checkout itself: build dist/ first, then compare and check. This is
#    the same order CI uses, so a local pass predicts the remote one.
#
#    A successful run is recorded for this exact commit under .git/ and reused
#    when the same clean commit is pushed to a second remote. A dirty tree, a
#    new commit, or a changed runtime/compiler/installed tree is not a hit.
head_sha=$(git rev-parse HEAD)
if [ -z "$(git status --porcelain)" ] && bin/gate-cache check "$head_sha" 2>/dev/null; then
	printf 'pre-push: %s already gated in this checkout; skipping build and checks\n' \
		"$(git rev-parse --short=12 "$head_sha")"
else
	code_fail=0
	if ! out=$(bin/check-dist 2>&1); then printf '%s\n' "$out" >&2; code_fail=1; fi

	# 3. The fence, the tag at HEAD (if any), the suites, and the example.
	#    Quiet on success; the full output is shown only when it fails.
	if ! out=$(bin/check 2>&1); then printf '%s\n' "$out" >&2; code_fail=1; fi

	if [ "$code_fail" -eq 0 ] && [ -x node_modules/.bin/tsc ] &&
		[ -z "$(git status --porcelain)" ]; then
		bin/gate-cache record "$head_sha" >/dev/null 2>&1 || true
	fi
	[ "$code_fail" -eq 0 ] || fail=1
fi

if [ "$fail" -ne 0 ]; then
	printf 'pre-push: push refused\n' >&2
	exit 1
fi
printf 'pre-push: ok\n'
