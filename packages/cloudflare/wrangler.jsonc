// The Cloudflare reference runtime's test Worker.
//
// T6.1 proves the real local runtime and a SQLite-backed Durable Object;
// T6.2 adds the organization coordinator and T6.3 the operation coordinator.
// T6.4 adds the AuthorityRuntime service entrypoint and conformance; T6.5
// adds ops and state lifecycle.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "org-hats-cloudflare-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-24",
  "workers_dev": false,
  // Local/test ops credential only. A deployment sets a secret of the same
  // name instead of committing a value.
  "vars": { "OPS_TOKEN": "test-ops-token" },
  "durable_objects": {
    "bindings": [
      { "name": "COUNTER", "class_name": "Counter" },
      { "name": "ORGANIZATION", "class_name": "OrganizationAuthority" },
      { "name": "OPERATION", "class_name": "OperationAuthority" },
      { "name": "SUBJECT_GUARD", "class_name": "PrincipalSubjectGuard" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Counter", "OrganizationAuthority"] },
    { "tag": "v2", "new_sqlite_classes": ["OperationAuthority"] },
    { "tag": "v3", "new_sqlite_classes": ["PrincipalSubjectGuard"] }
  ]
}
