#!/usr/bin/env sh
# Cut a release: bump a manifest, verify, rebuild dist/, commit, and tag.
#
#   bin/release patch                 # root: vX.Y.Z from package.json
#   bin/release minor
#   bin/release major
#   bin/release 2.1.0
#   bin/release --package cloudflare minor
#
# Two tag families, each tied to its own manifest:
#   root        vX.Y.Z            package.json + dist/
#   cloudflare  cloudflare-vX.Y.Z  packages/cloudflare/package.json
#
# The tag is taken from that manifest, and `bin/check-version` re-checks the
# new tag before anything is pushed, so the manifest and tag cannot disagree.
# `bin/check-dist` runs first, so a release commit cannot publish a stale
# dist/.
#
# Options:
#   --package root|cloudflare   which package to release (default: root)
#   --dry-run                   print the plan and change nothing
#   --push                      push the branch and tag to origin, then the GitHub mirror
#   --no-verify                 skip the gates (the build still runs)
#   --no-cloudflare             skip the Cloudflare suites on a root release
#   -h, --help                  this help
set -eu
cd "$(dirname "$0")/.." || exit 1

die() { printf 'release: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; }

package=root
bump=
dry=false
push=false
verify=true
cloudflare=true

while [ "$#" -gt 0 ]; do
	case $1 in
		--package)
			[ "$#" -ge 2 ] || die "--package needs root or cloudflare"
			package=$2
			shift 2
			;;
		--package=*)
			package=${1#--package=}
			shift
			;;
		--dry-run) dry=true; shift ;;
		--push) push=true; shift ;;
		--no-verify) verify=false; shift ;;
		--no-cloudflare) cloudflare=false; shift ;;
		-h|--help) usage; exit 0 ;;
		-*) die "unknown option: $1" ;;
		*)
			[ -z "$bump" ] || die "only one bump or version argument"
			bump=$1
			shift
			;;
	esac
done

[ -n "$bump" ] || { usage; exit 2; }

case $package in
	root)
		manifest=package.json
		tag_prefix=v
		;;
	cloudflare)
		manifest=packages/cloudflare/package.json
		tag_prefix=cloudflare-v
		;;
	*) die "unknown package: $package (root or cloudflare)" ;;
esac
[ -f "$manifest" ] || die "no manifest: $manifest"

command -v git >/dev/null 2>&1 || die "git is required"
command -v node >/dev/null 2>&1 || die "node is required"
command -v pnpm >/dev/null 2>&1 || die "pnpm is required"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not a git repository"

current=$(node -p "require('./$manifest').version")
next=$(node -e '
const [cur, bump] = process.argv.slice(1);
const semver = /^[0-9]+\.[0-9]+\.[0-9]+$/;
if (semver.test(bump)) { console.log(bump); process.exit(0); }
if (!semver.test(cur)) { console.error("current version is not semver: " + cur); process.exit(1); }
let [maj, min, pat] = cur.split(".").map(Number);
if (bump === "patch") pat += 1;
else if (bump === "minor") { min += 1; pat = 0; }
else if (bump === "major") { maj += 1; min = 0; pat = 0; }
else { console.error("unknown bump: " + bump); process.exit(1); }
console.log([maj, min, pat].join("."));
' "$current" "$bump") || die "could not compute the next version from '$bump'"

[ "$next" != "$current" ] || die "already at $current"
tag="${tag_prefix}${next}"
if git rev-parse -q --verify "refs/tags/$tag" >/dev/null 2>&1; then
	die "tag $tag already exists"
fi

printf 'release: %s -> %s  (%s)\n' "$current" "$next" "$tag"
printf 'release: manifest %s\n' "$manifest"

if $dry; then
	printf 'release: dry run — nothing changed\n'
	exit 0
fi

[ -z "$(git status --porcelain)" ] || die "working tree is dirty — commit or stash first"

if $verify; then
	printf '\n== check-dist ==\n'
	bin/check-dist

	printf '\n== bin/check ==\n'
	bin/check

	if [ "$package" = cloudflare ] || $cloudflare; then
		printf '\n== Cloudflare suites ==\n'
		pnpm check:cloudflare
	fi
fi

# The manifest is the single pinned version. Replace only that value so the
# rest of the file's formatting is untouched.
node -e 'const fs=require("fs"),p=process.argv[1],o=process.argv[2],n=process.argv[3];
	fs.writeFileSync(p, fs.readFileSync(p,"utf8").split(o).join(n));' "$manifest" "$current" "$next"

printf '\n== build ==\n'
pnpm build

# A root release commits the rebuilt dist/. A Cloudflare release must not
# change it: that would be a root source change smuggled into this tag.
if [ "$package" = cloudflare ] && [ -n "$(git status --porcelain -- dist)" ]; then
	die "dist/ changed during a Cloudflare release — commit the root build separately"
fi

if [ "$package" = root ]; then
	git add "$manifest"
	git add -A dist
else
	git add "$manifest"
fi

git commit -q -m "$tag"
git tag -a "$tag" -m "$tag"

# Post-tag check: the guard that would have caught a tag on the wrong commit.
bin/check-version "$tag"

if $push; then
	git push origin HEAD
	git push origin "$tag"
	if git remote get-url github >/dev/null 2>&1; then
		git push github HEAD
		git push github "$tag"
		printf 'release: pushed branch and %s to origin and github\n' "$tag"
	else
		printf 'release: no github remote; origin pushed, mirror skipped\n' >&2
	fi
else
	printf 'release: push with\n  git push origin HEAD\n  git push origin %s\n  git push github HEAD\n  git push github %s\n' "$tag" "$tag"
fi
