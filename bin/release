#!/usr/bin/env sh
# Cut a release: bump the version, rebuild dist/, run the check, commit, and tag.
#
#   bin/release patch        # 1.0.0 -> 1.0.1   (alias: bump_patch)
#   bin/release minor        # 1.0.0 -> 1.1.0   (alias: bump_minor)
#   bin/release major        # 1.0.0 -> 2.0.0   (alias: bump_major)
#   bin/release 1.1.0        # an explicit version
#
# The tag is taken from package.json — `v<version>` — so the tag and the
# manifest can never disagree. `package.json` is the only place the current
# version is pinned; docs refer to the latest tag, not a literal. Then
# `pnpm build` refreshes dist/ so the CI freshness guard passes.
#
# Options:
#   --dry-run     print the plan and change nothing
#   --push        push the branch and the tag to origin (default: local only)
#   --no-verify   skip bin/check before committing
#   -h, --help    this help
set -eu
cd "$(dirname "$0")/.." || exit 1

die() { printf 'release: %s\n' "$*" >&2; exit 1; }
usage() { sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//'; }

bump=
dry=false
push=false
verify=true
for arg in "$@"; do
	case $arg in
		patch | bump_patch) bump=patch ;;
		minor | bump_minor) bump=minor ;;
		major | bump_major) bump=major ;;
		--dry-run) dry=true ;;
		--push) push=true ;;
		--no-verify) verify=false ;;
		-h | --help) usage; exit 0 ;;
		-*) die "unknown option: $arg" ;;
		*) bump=$arg ;;
	esac
done
[ -n "$bump" ] || { usage; exit 2; }

command -v git >/dev/null 2>&1 || die "git is required"
command -v node >/dev/null 2>&1 || die "node is required"
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not a git repository"
[ -z "$(git status --porcelain)" ] || die "working tree is dirty — commit or stash first"

current=$(node -p "require('./package.json').version")
next=$(node -e '
const [cur, bump] = process.argv.slice(1);
const semver = /^[0-9]+\.[0-9]+\.[0-9]+$/;
if (semver.test(bump)) { console.log(bump); process.exit(0); }
if (!semver.test(cur)) { console.error("current version is not semver: " + cur); process.exit(1); }
let [maj, min, pat] = cur.split(".").map(Number);
if (bump === "patch") pat += 1;
else if (bump === "minor") { min += 1; pat = 0; }
else if (bump === "major") { maj += 1; min = 0; pat = 0; }
else { console.error("unknown bump: " + bump); process.exit(1); }
console.log([maj, min, pat].join("."));
' "$current" "$bump") || die "could not compute the next version from '$bump'"

[ "$next" != "$current" ] || die "already at $current"
if git rev-parse -q --verify "refs/tags/v$next" >/dev/null 2>&1; then
	die "tag v$next already exists"
fi

printf 'release: %s -> %s  (tag v%s)\n' "$current" "$next" "$next"
printf 'release: will bump package.json and rebuild dist/\n'

if $dry; then
	printf 'release: dry run — nothing changed\n'
	exit 0
fi

if $verify; then
	printf '\n== bin/check ==\n'
	bin/check
fi

# The manifest is the single pinned version. Docs name the latest tag rather
# than a literal, so a release never rewrites historical statements.
node -e 'const fs=require("fs"),p=process.argv[1],o=process.argv[2],n=process.argv[3];
	fs.writeFileSync(p, fs.readFileSync(p,"utf8").split(o).join(n));' package.json "$current" "$next"

printf '\n== build ==\n'
if command -v pnpm >/dev/null 2>&1; then
	pnpm build
elif [ -x node_modules/.bin/tsc ]; then
	node_modules/.bin/tsc -p tsconfig.json
else
	die "no build tool — install pnpm (pnpm install) and retry"
fi

git add -A
git commit -q -m "v$next"
git tag -a "v$next" -m "v$next"
printf 'release: committed and tagged v%s (%s)\n' "$next" "$(git rev-parse --short HEAD)"

if $push; then
	git push origin HEAD
	git push origin "v$next"
	printf 'release: pushed branch and v%s to origin\n' "$next"
else
	printf 'release: push with\n  git push origin HEAD\n  git push origin v%s\n' "$next"
fi
