#!/usr/bin/env sh
# The module check: the release-metadata guard, the portable fence, the
# cloudflare-import guard, the tests/examples typecheck, and the suites. A
# failure anywhere fails the run.
set -eu
cd "$(dirname "$0")/.."

if ! command -v node >/dev/null 2>&1; then
  echo "node is required" >&2
  exit 1
fi

if [ ! -x node_modules/.bin/tsc ]; then
  echo "tsc is required — run 'pnpm install'" >&2
  exit 1
fi

echo "== release metadata: a version tag matches package.json =="
"$(dirname "$0")/check-version"

echo
echo "== fence: all of src compiles without node or cloudflare types =="
node_modules/.bin/tsc -p tsconfig.authority.json
echo "ok — contract, authority, and access compile with types: []"

echo
echo "== fence: no cloudflare imports anywhere in src =="
# The fences read every file: --no-ignore --hidden --text keeps grep -R's
# totality. rg's interactive defaults skip gitignored, hidden, and binary
# content — the wrong direction for a fence, which fails closed on sight.
if rg --no-ignore --hidden --text -n -e "cloudflare:" -e "@cloudflare/" src; then
  echo "fail — src must not import cloudflare" >&2
  exit 1
fi
echo "ok — no cloudflare imports"

echo
echo "== fence: published declarations use runtime specifiers =="
if rg --no-ignore --hidden --text -n -g '*.d.ts' 'from "\.{1,2}/[^"]+\.ts"' dist; then
  echo "fail — a .d.ts imports a .ts specifier; consumers without skipLibCheck break" >&2
  exit 1
fi
echo "ok — dist declarations use .js specifiers"

echo
echo "== fence: the published surface takes plain string ids =="
# Incremental: the first run after a dist/ change is cold, a repeat is warm.
# tsconfig.consumer.json keeps the build info inside node_modules.
node_modules/.bin/tsc -p tsconfig.consumer.json
echo "ok — a consumer builds commands and reads claims without an id constructor"

echo
echo "== fence: tests and examples typecheck =="
node_modules/.bin/tsc -p tsconfig.tests.json
echo "ok — suites and examples typecheck"

echo
echo "== v1 suites (node:test) =="
node --test tests/*.test.ts

echo
echo "== portable examples =="
node examples/pilot.ts
node examples/own-world.ts
node examples/consumer-access.ts

echo
echo "all checks passed"
