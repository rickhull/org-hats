#!/usr/bin/env sh
# The module check: the portable fence, the cloudflare-import guard, the
# v1 suites, then the release-metadata guard. A failure anywhere fails the run.
set -eu
cd "$(dirname "$0")/.."

if ! command -v node >/dev/null 2>&1; then
  echo "node is required" >&2
  exit 1
fi

echo "== fence: all of src compiles without node or cloudflare types =="
if [ -x node_modules/.bin/tsc ]; then
  node_modules/.bin/tsc -p tsconfig.authority.json
  echo "ok — contract, authority, and access compile with types: []"
else
  echo "(skipped — run 'pnpm install' to enable the fence)"
fi

echo
echo "== fence: no cloudflare imports anywhere in src =="
if grep -Rn -e "cloudflare:" -e "@cloudflare/" src; then
  echo "fail — src must not import cloudflare" >&2
  exit 1
fi
echo "ok — no cloudflare imports"

echo
echo "== fence: published declarations use runtime specifiers =="
if grep -RIn --include='*.d.ts' -E 'from "\.{1,2}/[^"]+\.ts"' dist; then
  echo "fail — a .d.ts imports a .ts specifier; consumers without skipLibCheck break" >&2
  exit 1
fi
echo "ok — dist declarations use .js specifiers"

echo
echo "== v1 suites (node:test) =="
node --test tests/*.test.ts

echo
echo "== portable example =="
node examples/pilot.ts

echo
echo "== release metadata: a version tag matches package.json =="
"$(dirname "$0")/check-version"

echo
echo "all checks passed"
