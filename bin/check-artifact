#!/usr/bin/env node
// The deployable-artifact gate for the Cloudflare reference runtime.
//
// `bin/release --package cloudflare` calls this before the release commit and
// tag; CI and an operator can call it with a tag. It verifies the tag object,
// the package version, the production Worker configuration, and — when the
// checkout matches the tag — that `wrangler deploy --dry-run` bundles it.
//
// It never deploys, never reads a secret, and never touches the network.

import { spawnSync } from "node:child_process";
import { existsSync, mkdtempSync, readFileSync, rmSync } from "node:fs";
import { tmpdir } from "node:os";
import { dirname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const scriptRoot = resolve(dirname(fileURLToPath(import.meta.url)), "..");
const WORKER_NAME = "reporting-stream-authority";

const fail = (message) => {
  console.error(`check-artifact: ${message}`);
  process.exit(1);
};

const command = (bin, args, cwd, { allowFailure = false } = {}) => {
  const result = spawnSync(bin, args, { cwd, encoding: "utf8" });
  if (result.error !== undefined) fail(`${bin} could not run: ${result.error.message}`);
  if (result.status !== 0 && !allowFailure) {
    const detail = (result.stderr || result.stdout || "").trim();
    fail(`${bin} ${args.join(" ")} failed${detail === "" ? "" : `\n${detail}`}`);
  }
  return result;
};

const git = (root, args, options) => command("git", ["-C", root, ...args], root, options);

const atTag = (root, tag, path) => git(root, ["show", `${tag}:${path}`]).stdout;

const atWorkingTree = (root, path) => {
  const absolute = join(root, path);
  if (!existsSync(absolute)) fail(`missing ${path}`);
  return readFileSync(absolute, "utf8");
};

/** JSONC as this repository writes it: line comments outside strings, no
 * trailing commas. A full JSONC parser would be a dependency for one file. */
const parseJsonc = (text, path) =>
  JSON.parse(text.replace(/^\s*\/\/.*$/gm, ""));

const usage = () => {
  console.log(`usage: bin/check-artifact [cloudflare-vX.Y.Z] [--root <path>] [--no-build]

With no tag, validates the working tree; bin/release calls it after the
manifest bump. With a tag, validates the annotated tag, its package manifest,
and its production configuration. The bundle build runs when the checkout is
the tag (or always in working-tree mode); --no-build skips it.`);
};

const args = process.argv.slice(2);
let tag;
let root = scriptRoot;
let build = true;

for (let i = 0; i < args.length; i += 1) {
  const arg = args[i];
  if (arg === "--help" || arg === "-h") {
    usage();
    process.exit(0);
  } else if (arg === "--root") {
    const next = args[i + 1];
    if (next === undefined) fail("--root needs a path");
    root = resolve(next);
    i += 1;
  } else if (arg === "--no-build") {
    build = false;
  } else if (arg.startsWith("-")) {
    fail(`unknown option ${arg}`);
  } else if (tag === undefined) {
    tag = arg;
  } else {
    fail("only one tag may be given");
  }
}

if (!existsSync(join(root, "packages", "cloudflare", "package.json"))) {
  fail(`${root} does not look like the org-hats repository`);
}

let commit;
if (tag !== undefined) {
  const type = git(root, ["cat-file", "-t", tag]).stdout.trim();
  if (type !== "tag") fail(`${tag} is not an annotated tag`);
  commit = git(root, ["rev-parse", `${tag}^{}`]).stdout.trim();
  if (!/^[0-9a-f]{40}$/.test(commit)) fail(`${tag} does not peel to a full commit`);
}

const manifestPath = "packages/cloudflare/package.json";
const configPath = "packages/cloudflare/wrangler.production.jsonc";
const read = tag === undefined
  ? (path) => atWorkingTree(root, path)
  : (path) => atTag(root, tag, path);

const manifest = JSON.parse(read(manifestPath));
if (typeof manifest.version !== "string") fail(`${manifestPath} has no version`);
if (tag !== undefined && tag !== `cloudflare-v${manifest.version}`) {
  fail(`${tag} does not match ${manifestPath} version ${manifest.version}`);
}

const config = parseJsonc(read(configPath), configPath);
if (config.name !== WORKER_NAME) {
  fail(`${configPath} names ${JSON.stringify(config.name)}, expected ${WORKER_NAME}`);
}
if (config.workers_dev !== false) fail(`${configPath} must set workers_dev false`);
if (config.routes !== undefined && !(Array.isArray(config.routes) && config.routes.length === 0)) {
  fail(`${configPath} must not declare routes`);
}
if (typeof config.main !== "string" || config.main.length === 0) {
  fail(`${configPath} must name a main module`);
}
const mainPath = join("packages", "cloudflare", config.main).replaceAll("\\", "/");
if (tag === undefined) {
  if (!existsSync(join(root, mainPath))) fail(`missing ${mainPath}`);
} else {
  const present = git(root, ["cat-file", "-e", `${tag}:${mainPath}`], { allowFailure: true });
  if (present.status !== 0) fail(`${tag} does not contain ${mainPath}`);
}

let built = false;
if (build) {
  const head = git(root, ["rev-parse", "HEAD"]).stdout.trim();
  if (tag !== undefined && head !== commit) {
    console.log(`check-artifact: ${tag} differs from HEAD; skipping the bundle build`);
  } else {
    const outdir = mkdtempSync(join(tmpdir(), "org-hats-deploy-"));
    try {
      const result = command(
        "pnpm",
        [
          "--filter",
          "org-hats-cloudflare",
          "exec",
          "wrangler",
          "deploy",
          "--dry-run",
          "--outdir",
          outdir,
          "--config",
          "wrangler.production.jsonc",
        ],
        root,
      );
      if (!existsSync(join(outdir, "index.js"))) {
        fail(`the bundle did not produce index.js\n${(result.stdout || "").trim()}`);
      }
      built = true;
    } finally {
      rmSync(outdir, { recursive: true, force: true });
    }
  }
}

const label = tag === undefined
  ? `working tree (version ${manifest.version})`
  : `${tag} -> ${commit.slice(0, 12)} (version ${manifest.version})`;
console.log(`check-artifact: ${label}`);
console.log(`check-artifact: ${config.name}, no routes, workers_dev false`);
if (built) console.log("check-artifact: bundle ok");
console.log("check-artifact: ok");
