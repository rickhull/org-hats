#!/usr/bin/env sh
# Release-metadata guard: a `vX.Y.Z` tag must match `package.json`'s version.
#
#   bin/check-version            # the tag at this checkout (or $GITHUB_REF in CI)
#   bin/check-version v0.4.3     # audit a named tag against its own manifest
#
# Static: it reads the manifest and the tag, builds nothing, runs nothing. A
# commit with no version tag passes — there is nothing to reconcile. Invoked by
# bin/check (and so by CI on every push); safe to call from a git hook too.
set -eu
cd "$(dirname "$0")/.." || exit 1

die() { printf 'check-version: %s\n' "$*" >&2; exit 1; }

manifest_version() { # a package.json on stdin -> its version on stdout
	node -e 'const fs=require("fs");process.stdout.write(String(JSON.parse(fs.readFileSync(0,"utf8")).version||""))'
}

check() { # tag version
	[ -n "$2" ] || die "no version in package.json"
	[ "$1" = "v$2" ] || die "tag $1 does not match package.json version $2 (expected v$2)"
	printf 'check-version: %s matches package.json %s\n' "$1" "$2"
}

command -v node >/dev/null 2>&1 || die "node is required"
command -v git >/dev/null 2>&1 || die "git is required"

# An explicit argument audits that tag against the manifest in its own commit.
if [ "$#" -gt 0 ]; then
	tag=${1#refs/tags/}
	git rev-parse -q --verify "refs/tags/$tag" >/dev/null 2>&1 || die "no such tag: $tag"
	version=$(git show "$tag:package.json" | manifest_version)
	check "$tag" "$version"
	exit 0
fi

# Otherwise check the tag at this checkout: $GITHUB_REF in CI, else tags at HEAD.
version=$(manifest_version <package.json)
tags=
case "${GITHUB_REF:-}" in refs/tags/*) tags=${GITHUB_REF#refs/tags/} ;; esac
[ -n "$tags" ] || tags=$(git tag --points-at HEAD 2>/dev/null || true)

checked=0
for tag in $tags; do
	case $tag in
		v[0-9]*.[0-9]*.[0-9]*) ;;
		*) continue ;; # a non-version tag is not this guard's business
	esac
	checked=1
	check "$tag" "$version"
done
[ "$checked" -eq 1 ] || printf 'check-version: no version tag at this checkout (%s)\n' "${tags:-untagged}"
